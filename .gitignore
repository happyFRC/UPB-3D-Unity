# 此文件由LLM生成

# 这些是Unity运行时自动生成的文件夹
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# 忽略过大的崩溃报告和内存快照
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 忽略IDE（如VS Code/Rider）生成的本地配置文件
.vs/
.vscode/
.idea/
.consulo/
ExportedObj/

# 忽略解决方案和项目文件
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# 忽略打包生成的文件
*.apk
*.aab
*.unitypackage
*.app

# 忽略特定插件的本地缓存
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/Plugins/Editor/JetBrains*

# 忽略临时生成的Android资源
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/Real Stars Skybox

# UPB 玩家数据（编辑器里落在工程根目录，打包后在游戏目录）
# 含：游玩时长 playtime.json、模组开关 mods.json 等
/UPB-data/*

# 玩家游玩产生的数据
/screenshots/
/simulations/

# 模组工程例外：csproj / sln 要进仓库，否则别人拉下来没有补全
!Mods/**/*.csproj
!Mods/**/*.sln
!BuiltinMods/**/*.csproj
!BuiltinMods/**/*.sln

# 模组工程的编译产物（csproj 只给 IDE 用）
/Mods/*/bin/
/Mods/*/obj/
/BuiltinMods/*/bin/
/BuiltinMods/*/obj/

# 本地自动化桥接（编辑器命令文件）
/.agents-unity-bridge/
